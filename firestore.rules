rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has verified their age
    function isAgeVerified() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ageVerified == true;
    }

    // Check if field value is valid gender
    function isValidGender(gender) {
      return gender == 'male' || gender == 'female' || gender == 'any' || gender == '';
    }

    // Check if account is not suspended
    function isNotSuspended() {
      return isAuthenticated() &&
        (!exists(/databases/$(database)/documents/suspensions/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/suspensions/$(request.auth.uid)).data.isActive != true);
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================

    match /users/{userId} {
      // Allow read own document always
      allow read: if isOwner(userId);

      // Allow read other users' basic info only if age verified
      allow read: if isAuthenticated() &&
                     isAgeVerified() &&
                     resource.data.ageVerified == true;

      // Allow create own document with required fields
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasAll(['uid', 'ageVerified']) &&
                       request.resource.data.uid == userId &&
                       request.resource.data.ageVerified == true;

      // Allow update own document with field validation
      allow update: if isOwner(userId) &&
                       request.resource.data.uid == userId &&
                       validateUserUpdate();

      // Disallow delete (admin only via Admin SDK)
      allow delete: if false;

      function validateUserUpdate() {
        let incoming = request.resource.data;
        let existing = resource.data;

        // Cannot change uid
        return incoming.uid == existing.uid &&
               // Validate gender if present
               (!incoming.keys().hasAny(['gender']) || isValidGender(incoming.gender)) &&
               (!incoming.keys().hasAny(['preferredGender']) || isValidGender(incoming.preferredGender)) &&
               // Heart count must be non-negative
               (!incoming.keys().hasAny(['heartCount']) || incoming.heartCount >= 0) &&
               // Cannot directly modify suspension-related fields
               incoming.get('isSuspended', existing.get('isSuspended', false)) == existing.get('isSuspended', false);
      }
    }

    // =========================================================================
    // REPORTS COLLECTION
    // =========================================================================

    match /reports/{reportId} {
      // Users cannot read reports (admin only)
      allow read: if false;

      // Allow create report with proper validation
      allow create: if isAuthenticated() &&
                       isAgeVerified() &&
                       isNotSuspended() &&
                       validateReport();

      // No update or delete allowed
      allow update, delete: if false;

      function validateReport() {
        let report = request.resource.data;

        return report.keys().hasAll(['reportedUserId', 'reporterUserId', 'reason', 'timestamp', 'status']) &&
               // Reporter must be current user
               report.reporterUserId == request.auth.uid &&
               // Cannot report self
               report.reportedUserId != request.auth.uid &&
               // Status must be pending
               report.status == 'pending' &&
               // Reason must be valid
               report.reason is string &&
               report.reason.size() > 0 &&
               report.reason.size() <= 500 &&
               // IDs must be valid strings
               report.reportedUserId is string &&
               report.reporterUserId is string;
      }
    }

    // =========================================================================
    // SUSPENSIONS COLLECTION
    // =========================================================================

    match /suspensions/{suspensionId} {
      // User can only read their own suspension
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Only system can create/modify (via Admin SDK)
      allow create, update, delete: if false;
    }

    // =========================================================================
    // MATCHES COLLECTION (Firestore backup for analytics)
    // =========================================================================

    match /matches/{matchId} {
      // Participants can read their matches
      allow read: if isAuthenticated() &&
                     (resource.data.user1 == request.auth.uid ||
                      resource.data.user2 == request.auth.uid);

      // Only Cloud Functions create matches
      allow create: if false;

      // Participants can update match status
      allow update: if isAuthenticated() &&
                       (resource.data.user1 == request.auth.uid ||
                        resource.data.user2 == request.auth.uid) &&
                       validateMatchUpdate();

      allow delete: if false;

      function validateMatchUpdate() {
        let incoming = request.resource.data;
        let existing = resource.data;

        // Cannot change core match data
        return incoming.user1 == existing.user1 &&
               incoming.user2 == existing.user2 &&
               incoming.channelName == existing.channelName &&
               // Can only change status to 'ended'
               (incoming.status == existing.status || incoming.status == 'ended');
      }
    }

    // =========================================================================
    // PURCHASES COLLECTION (StoreKit transaction records)
    // =========================================================================

    match /purchases/{purchaseId} {
      // User can read own purchases
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Allow create own purchase record
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       validatePurchase();

      // No update/delete
      allow update, delete: if false;

      function validatePurchase() {
        let purchase = request.resource.data;

        return purchase.keys().hasAll(['userId', 'productId', 'transactionId', 'purchaseDate']) &&
               purchase.userId is string &&
               purchase.productId is string &&
               purchase.transactionId is string;
      }
    }

    // =========================================================================
    // DAILY REWARDS COLLECTION
    // =========================================================================

    match /dailyRewards/{rewardId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    // =========================================================================
    // BLOCK DEFAULT ACCESS
    // =========================================================================

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
