{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "matching_queue": {
      ".indexOn": ["bucket", "timestamp", "status", "gender", "preferredGender"],
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "matches": {
      ".read": "auth != null",
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
